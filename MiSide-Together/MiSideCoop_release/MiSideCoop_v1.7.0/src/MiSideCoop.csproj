<Project Sdk="Microsoft.NET.Sdk">

  <!-- ================================================================
       MiSide Co-op Mod — Fichier de projet MSBuild (mode NuGet hybride)
       Compilez avec : dotnet build MiSideCoop.csproj -c Release

       Stratégie :
         • Les références BepInEx 6 IL2CPP + Unity sont récupérées via NuGet
           (packages publics et stables).
         • Les classes propres à MiSide (PlayerMove, ObjectDoor, ObjectItem…)
           NE sont pas référencées au compile : les Harmony patches utilisent
           AccessTools.TypeByName("PlayerMove") pour les résoudre au runtime.
       ================================================================ -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MiSideCoop</AssemblyName>
    <RootNamespace>MiSideCoop</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <Platforms>x64</Platforms>
    <OutputPath>bin\Release\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0672;CS1591;CS8632;CS0436;CS0114;CS0108;CS0414;CS8981;CS0162</NoWarn>
    <RestoreSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json;https://nuget.samboy.dev/v3/index.json</RestoreSources>
  </PropertyGroup>

  <!-- ================================================================
       Packages NuGet : BepInEx 6 IL2CPP + Unity reference assemblies
       ================================================================ -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.725" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.18" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Référence locale : UnityEngine.UI (uGUI - Button, Text, InputField) -->
  <ItemGroup>
    <Reference Include="UnityEngine.UI">
      <HintPath>Refs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

